# ============================================================
# .dockerignore - Files to exclude from Docker build
# ============================================================

# Version control
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info
dist
build
.eggs

# Virtual environments
venv
.venv
env
.env
ENV

# IDE
.vscode
.idea
*.swp
*.swo

# Testing
.pytest_cache
.coverage
htmlcov
.tox
.mypy_cache
.ruff_cache

# Data files
data/
*.csv
*.parquet
*.h5
*.pkl

# Logs
logs/
*.log

# Notebooks
*.ipynb
notebooks/

# CI/CD
.github/
.gitlab/

# Local configuration
.env.local
.env.*.local

# Model files (we copy models/ explicitly)
# But exclude test models
test_models/

# Documentation
docs/
README.md
*.md

# Deployment files (not needed in container)
docker-compose.yml
kubernetes/